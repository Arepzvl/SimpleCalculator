<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#374151">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calculator"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#F3F4F6"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- Number Inputs Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg_grey"
        android:padding="16dp"
        android:elevation="2dp"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/editTextNumber1"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="First number"
            android:inputType="numberDecimal"
            android:background="#00000000"
            android:textSize="18sp"
            android:textColor="#F3F4F6"
            android:textColorHint="#9CA3AF" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#4B5563"
            android:layout_marginVertical="8dp" />

        <EditText
            android:id="@+id/editTextNumber2"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Second number"
            android:inputType="numberDecimal"
            android:background="#00000000"
            android:textSize="18sp"
            android:textColor="#F3F4F6"
            android:textColorHint="#9CA3AF" />
    </LinearLayout>

    <!-- Operation Buttons Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="2"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/buttonAdd"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="+"
            android:textSize="24sp"
            android:textStyle="bold"
            android:backgroundTint="#F59E0B"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/buttonSubtract"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="-"
            android:textSize="24sp"
            android:textStyle="bold"
            android:backgroundTint="#F59E0B"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/buttonMultiply"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="×"
            android:textSize="24sp"
            android:textStyle="bold"
            android:backgroundTint="#F59E0B"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/buttonDivide"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="÷"
            android:textSize="24sp"
            android:textStyle="bold"
            android:backgroundTint="#F59E0B"
            android:textColor="#FFFFFF" />

    </GridLayout>

    <!-- Clear Button -->
    <Button
        android:id="@+id/buttonClear"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="CLEAR"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#EF4444"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <!-- Result & History Display Screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/card_bg_grey"
        android:padding="16dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESULT"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#9CA3AF" />

        <TextView
            android:id="@+id/textViewResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#4B5563"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HISTORY"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#9CA3AF"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textViewHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="No history"
            android:textSize="15sp"
            android:textColor="#D1D5DB"
            android:scrollbars="vertical" />
    </LinearLayout>

</LinearLayout>